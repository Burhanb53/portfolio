# Copy this file to .env.local and fill in the real values. .env.local is git-ignored.
# The same variables must be added in Vercel: Project → Settings → Environment Variables.

GMAIL_USER=burhanb53.work@gmail.com
# A 16-character Google App Password (Google Account → Security → 2-Step Verification → App passwords).
# Spaces are fine to leave out.
GMAIL_APP_PASSWORD=
# Optional: where enquiries are delivered (defaults to GMAIL_USER)
CONTACT_TO=
# Your live site address: used for share previews and linked from the confirmation email
SITE_URL=https://burhanb53.dev
